    "/api/v1/lotes": {
      "post": {
        "summary": "Cria um lote (e opcionalmente seus equipamentos) em uma unica transacao",
        "tags": [
          "lotes"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "orgCnpj",
                  "nf",
                  "transportadora"
                ],
                "additionalProperties": false,
                "properties": {
                  "orgCnpj": {
                    "type": "string"
                  },
                  "nf": {
                    "type": "string"
                  },
                  "transportadora": {
                    "type": "string"
                  },
                  "dataEntrada": {
                    "type": "string",
                    "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                  },
                  "equipamentos": {
                    "type": "array",
                    "maxItems": 500,
                    "items": {
                      "type": "object",
                      "required": [
                        "tipo"
                      ],
                      "additionalProperties": false,
                      "properties": {
                        "tipo": {
                          "type": "string",
                          "pattern": "\\S",
                          "description": "Tipo do equipamento (nao pode ser vazio)."
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      },
      "get": {
        "tags": [
          "lotes"
        ],
        "parameters": [
          {
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            },
            "in": "query",
            "name": "pagina",
            "required": false
          },
          {
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            },
            "in": "query",
            "name": "tamanhoPagina",
            "required": false
          },
          {
            "schema": {
              "type": "string",
              "enum": [
                "recebido",
                "em_triagem",
                "triagem_completa",
                "encerrado"
              ]
            },
            "in": "query",
            "name": "status",
            "required": false
          },
          {
            "schema": {
              "type": "string"
            },
            "in": "query",
            "name": "cnpj",
            "required": false
          },
          {
            "schema": {
              "type": "boolean",
              "default": false
            },
            "in": "query",
            "name": "incluirInativos",
            "required": false,
            "description": "Inclui registros inativados (soft delete)."
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
